# Settings for deploy/update.sh: copy to deploy/update.env (not in git) and adjust.
# Server: ssh host or alias (~/.ssh/config), e.g. vps or mario@203.0.113.5
TARGET=vps
# Release bundle; empty = the newest release/tourney-*.tar.gz (pnpm release)
BUNDLE=
# Folder with UTTourney_v1.u and UTTourneyMH_v1.u built on the PC (mod/build.ps1); empty = no mod
# WSL example for a UT folder C:\UnrealTournament: /mnt/c/UnrealTournament/System
MOD_DIR=
# UT folder on the server
UT_DIR=/opt/ut99
# Folder in the home of the ssh user for the uploaded files
REMOTE_DIR=tourney-update
# 1 = backup before the update
BACKUP=1
# 1 = update even while tournaments run (they break off)
FORCE=0
# Extra ssh/scp options, e.g. "-p 2222"
SSH_OPTS=
