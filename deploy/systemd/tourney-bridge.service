# Bridge agent next to the UT server (website mode). It starts and stops the UT server itself
# (server.manage = true), so it needs write access to the UT System folder.
#   sudo systemctl daemon-reload && sudo systemctl enable --now tourney-bridge
[Unit]
Description=UT99 tournament bridge
After=network-online.target
Wants=network-online.target

[Service]
User=ut99
WorkingDirectory=/opt/tourney
ExecStart=/usr/bin/node apps/bridge/dist/cli.js run -c /etc/tourney/bridge.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
