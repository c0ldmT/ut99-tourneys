# Copy to .env (development) or /etc/tourney/api.env (systemd). All values are optional except a login method.

# Where the website is reachable from the browser (Discord redirect, secure cookies for https).
PUBLIC_URL=http://localhost:8080
HOST=0.0.0.0
PORT=8080
DATA_DIR=./data
SITE_NAME=UT99 Tournaments

# Discord application (https://discord.com/developers/applications > OAuth2):
# redirect URL = <PUBLIC_URL>/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Only members of this Discord server may log in (right-click the server > Copy Server ID). Optional.
DISCORD_GUILD_ID=
# Discord user ids that are admins (comma separated). Admins can promote others on the website.
ADMIN_DISCORD_IDS=

# Discord notifications, all optional (leave empty to switch them off; wrong values only disable them).
# Channel: Server settings > Integrations > Webhooks > New webhook > Copy URL. Tournaments can use their
# own webhook or none (tournament form).
DISCORD_WEBHOOK_URL=
# Direct messages: Developer portal > your application > Bot > Reset Token. Invite the bot to your server
# (OAuth2 > URL generator, scope "bot"); it can only write to members of servers it is on.
DISCORD_BOT_TOKEN=
# Language of the messages: de or en.
NOTIFY_LANG=de
# Reminder this many minutes before the scheduled start (0 = none).
NOTIFY_REMIND_MIN=30

# Login by name without Discord: ONLY for local testing, never on a reachable server.
DEV_LOGIN=false

# Built Angular app; empty = apps/web/dist next to the API if it exists.
WEB_DIST=
LOG_LEVEL=info
