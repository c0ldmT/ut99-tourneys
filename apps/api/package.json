{
  "name": "@tourney/api",
  "version": "0.1.0",
  "private": true,
  "description": "Website backend: Discord login, tournaments, canonical event log, bridge agent gateway.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/main.js",
    "dev": "node --conditions=@tourney/source --env-file-if-exists=.env --import tsx src/main.ts",
    "udt:sim": "node --conditions=@tourney/source --import tsx scripts/udt-sim.ts",
    "udt:academy-sim": "node --conditions=@tourney/source --import tsx scripts/udt-academy-sim.ts",
    "bot:sim": "node --conditions=@tourney/source --import tsx scripts/bot-sim.ts",
    "db:anonymize": "node --conditions=@tourney/source --import tsx scripts/db-anonymize.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@tourney/adapter-ut99": "workspace:*",
    "@tourney/bracket": "workspace:*",
    "@tourney/protocol": "workspace:*",
    "@tourney/udt": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "express": "^5.2.1",
    "openskill": "5.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tourney/bridge": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15"
  }
}
