{
  "name": "@tourney/bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Bridge agent: runs next to the game server, drives matches, talks to the mod and the website.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tourney-bridge": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/cli.js",
    "sim": "node dist/sim-cli.js"
  },
  "dependencies": {
    "@tourney/adapter-ut99": "workspace:*",
    "@tourney/bracket": "workspace:*",
    "@tourney/protocol": "workspace:*",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2"
  },
  "exports": {
    ".": {
      "@tourney/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
